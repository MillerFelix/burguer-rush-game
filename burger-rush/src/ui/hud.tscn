[node name="TopLeft" type="MarginContainer" parent="."]
offset_right = 380.0
offset_bottom = 160.0
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16

[node name="OrdersLabel" type="Label" parent="TopLeft"]
