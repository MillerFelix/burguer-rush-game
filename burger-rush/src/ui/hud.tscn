[gd_scene format=3 uid="uid://hud_scene_uid"]

[ext_resource type="Script" path="res://src/ui/hud.gd" id="1_hud"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_Modal"]
bg_color = Color(0.12, 0.14, 0.18, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.8, 0.65, 0.3, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_SlotInactive"]
bg_color = Color(0.06, 0.08, 0.12, 0.65)
border_color = Color(0.20, 0.26, 0.36, 0.50)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 8
content_margin_top = 3
content_margin_right = 8
content_margin_bottom = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_SlotActive"]
bg_color = Color(0.16, 0.22, 0.32, 0.95)
border_color = Color(1.0, 0.85, 0.20, 1.0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 8
content_margin_top = 3
content_margin_right = 8
content_margin_bottom = 3

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Crosshair" type="ColorRect" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -2.0
offset_top = -2.0
offset_right = 2.0
offset_bottom = 2.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 1, 1, 0.75)

[node name="InteractionLabel" type="Label" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -250.0
offset_top = 20.0
offset_right = 250.0
offset_bottom = 50.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
text = "E — Pegar"
horizontal_alignment = 1
vertical_alignment = 1

[node name="TopRight" type="MarginContainer" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -220.0
offset_bottom = 60.0
grow_horizontal = 0
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20

[node name="MoneyLabel" type="Label" parent="TopRight"]
layout_mode = 2
