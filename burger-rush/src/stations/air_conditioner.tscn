[gd_scene format=3]

[ext_resource type="Script" path="res://src/stations/air_conditioner.gd" id="1_ac_script"]

; ================================================================
; COLISÃO DO AR-CONDICIONADO COMERCIAL DE PAREDE ALTA
; ================================================================

[sub_resource type="BoxShape3D" id="BoxShape3D_ACCol"]
size = Vector3(1.65, 0.52, 0.42)

; ================================================================
; MATERIAIS DO APARELHO DE CLIMATIZAÇÃO
; ================================================================

[sub_resource type="StandardMaterial3D" id="Material_ACPlasticWhite"]
albedo_color = Color(0.96, 0.97, 0.98, 1)
roughness = 0.22

[sub_resource type="StandardMaterial3D" id="Material_ChromeTrim"]
albedo_color = Color(0.88, 0.90, 0.92, 1)
metallic = 0.92
roughness = 0.15

[sub_resource type="StandardMaterial3D" id="Material_DarkIntake"]
albedo_color = Color(0.15, 0.16, 0.18, 1)
roughness = 0.70

[sub_resource type="StandardMaterial3D" id="Material_LEDStatus"]
albedo_color = Color(0.95, 0.15, 0.15, 1)
emission_enabled = true
emission = Color(0.95, 0.15, 0.15, 1)
emission_energy_multiplier = 1.5

[sub_resource type="StandardMaterial3D" id="Material_AirBreeze"]
transparency = 1
albedo_color = Color(0.85, 0.95, 1.0, 0.20)
roughness = 0.90

; ================================================================
; MESHES DO APARELHO
; ================================================================

[sub_resource type="BoxMesh" id="BoxMesh_Cabinet"]
material = SubResource("Material_ACPlasticWhite")
size = Vector3(1.60, 0.46, 0.36)

[sub_resource type="BoxMesh" id="BoxMesh_TopGrill"]
material = SubResource("Material_DarkIntake")
size = Vector3(1.52, 0.02, 0.28)

[sub_resource type="BoxMesh" id="BoxMesh_ChromeStrip"]
material = SubResource("Material_ChromeTrim")
size = Vector3(1.56, 0.02, 0.01)

[sub_resource type="BoxMesh" id="BoxMesh_Flap"]
material = SubResource("Material_ACPlasticWhite")
size = Vector3(1.52, 0.025, 0.14)

[sub_resource type="SphereMesh" id="SphereMesh_LED"]
radius = 0.018
height = 0.036
radial_segments = 10
rings = 4

[sub_resource type="SphereMesh" id="SphereMesh_AirParticle"]
material = SubResource("Material_AirBreeze")
radius = 0.08
height = 0.16
radial_segments = 6
rings = 4

; ================================================================
; HIERARQUIA DA CENA
; ================================================================

[node name="AirConditioner" type="StaticBody3D"]
script = ExtResource("1_ac_script")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_ACCol")

[node name="Model" type="Node3D" parent="."]

[node name="Body" type="Node3D" parent="Model"]

; Gabinete Principal Robusto
[node name="Cabinet" type="MeshInstance3D" parent="Model/Body"]
mesh = SubResource("BoxMesh_Cabinet")

; Grade de Entrada de Ar Superior
[node name="TopGrill" type="MeshInstance3D" parent="Model/Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.235, 0)
mesh = SubResource("BoxMesh_TopGrill")

; Friso Cromado Frontal
[node name="ChromeStrip" type="MeshInstance3D" parent="Model/Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.06, 0.182)
mesh = SubResource("BoxMesh_ChromeStrip")

; Identificação e Logotipo Discreto
[node name="BrandLabel" type="Label3D" parent="Model/Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.45, 0.08, 0.183)
text = "CLIMA-PRO 24.000 BTU"
font_size = 13
modulate = Color(0.35, 0.38, 0.42, 1)
outline_size = 0

; LED Indicador de Operação (Verde = Ligado / Vermelho = Desligado)
[node name="LEDStatus" type="MeshInstance3D" parent="Model/Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.65, -0.06, 0.186)
mesh = SubResource("SphereMesh_LED")
surface_material_override/0 = SubResource("Material_LEDStatus")

; Aleta Móvel Motorizada de Direcionamento de Ar
[node name="FlapPivot" type="Node3D" parent="Model/Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.21, 0.12)

[node name="AirFlap" type="MeshInstance3D" parent="Model/Body/FlapPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.06)
mesh = SubResource("BoxMesh_Flap")

; Efeito Visual de Fluxo de Ar Sutil
[node name="AirVentParticles" type="CPUParticles3D" parent="Model/Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.23, 0.22)
emitting = false
amount = 14
lifetime = 1.4
mesh = SubResource("SphereMesh_AirParticle")
emission_shape = 3
emission_box_extents = Vector3(0.68, 0.04, 0.04)
direction = Vector3(0, -0.6, 0.8)
spread = 22.0
gravity = Vector3(0, -0.15, 0)
initial_velocity_min = 0.4
initial_velocity_max = 0.8
scale_amount_min = 0.9
scale_amount_max = 1.8
color = Color(0.9, 0.95, 1.0, 0.25)

[node name="AudioStreamPlayer3D" type="AudioStreamPlayer3D" parent="."]
unit_size = 2.5
max_distance = 15.0
volume_db = -24.0
bus = &"Master"
