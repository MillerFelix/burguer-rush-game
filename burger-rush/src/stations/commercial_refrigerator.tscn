; ─── PORTA COM PIVOT DE DOBRADIÇA ───────────────────────────
; O pivot fica no canto ESQUERDO da porta (onde estão as dobradiças)
; Posição X = -0.70 (metade da largura da porta)
; Quando rotation_degrees.y = -85, a porta abre para o lado esquerdo

[node name="DoorPivot" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.70, 0, 0.345)

[node name="FridgeDoor" type="StaticBody3D" parent="DoorPivot"]
script = ExtResource("2_door")

; A porta é centrada no pivot — deve ser deslocada 0.70 no eixo X
; para que o canto esquerdo fique no pivot (ponto de rotação)
[node name="CollisionShape3D" type="CollisionShape3D" parent="DoorPivot/FridgeDoor"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.70, 1.02, 0)
shape = SubResource("Shape_Door")

; Frame escuro da porta
[node name="DoorFrame" type="MeshInstance3D" parent="DoorPivot/FridgeDoor"]
