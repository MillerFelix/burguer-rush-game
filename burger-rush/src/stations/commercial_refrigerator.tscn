transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.70, 1.02, 0.020)
mesh = SubResource("Mesh_Glass")

; Puxador (vertical, no lado direito da porta — onde o jogador puxa)
[node name="Handle" type="MeshInstance3D" parent="DoorPivot/FridgeDoor"]
