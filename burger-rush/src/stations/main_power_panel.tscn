[sub_resource type="CylinderMesh" id="CylinderMesh_Grip"]
material = SubResource("Material_GripRed")
top_radius = 0.026
bottom_radius = 0.026
height = 0.11
radial_segments = 14

[sub_resource type="SphereMesh" id="SphereMesh_LED"]
radius = 0.015
height = 0.03
radial_segments = 10
rings = 4

; ================================================================
; HIERARQUIA DA CENA
; ================================================================

[node name="MainPowerPanel" type="StaticBody3D"]
script = ExtResource("1_panel_script")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_PanelCol")

[node name="Model" type="Node3D" parent="."]

[node name="Enclosure" type="Node3D" parent="Model"]

; Caixa metálica principal
[node name="Cabinet" type="MeshInstance3D" parent="Model/Enclosure"]
mesh = SubResource("BoxMesh_Cabinet")

; Moldura frontal
[node name="DoorFrame" type="MeshInstance3D" parent="Model/Enclosure"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.09)
mesh = SubResource("BoxMesh_Door")

; Placa de fundo interna
[node name="InnerPlate" type="MeshInstance3D" parent="Model/Enclosure"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.088)
mesh = SubResource("BoxMesh_InnerPlate")

; Eletrodutos superior e inferior
