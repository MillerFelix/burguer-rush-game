[gd_scene format=3 uid="uid://main_power_panel_scene_uid"]

[ext_resource type="Script" path="res://src/stations/main_power_panel.gd" id="1_panel_script"]

; ================================================================
; COLISÃO DO QUADRO DE ENERGIA
; ================================================================

[sub_resource type="BoxShape3D" id="BoxShape3D_PanelCol"]
size = Vector3(0.58, 0.78, 0.30)

; ================================================================
; MATERIAIS REALISTAS E LIMPOS
; ================================================================

; Gabinete externo fosco texturizado cinza industrial
[sub_resource type="StandardMaterial3D" id="Material_CabinetBody"]
albedo_color = Color(0.28, 0.30, 0.33, 1)
metallic = 0.22
roughness = 0.58

; Moldura e chanfro da porta
[sub_resource type="StandardMaterial3D" id="Material_DoorTrim"]
albedo_color = Color(0.22, 0.24, 0.26, 1)
metallic = 0.30
roughness = 0.65

; Fundo interno galvanizado
[sub_resource type="StandardMaterial3D" id="Material_InnerChassis"]
albedo_color = Color(0.55, 0.58, 0.62, 1)
metallic = 0.65
roughness = 0.45

; Trilho DIN metálico
[sub_resource type="StandardMaterial3D" id="Material_DINRail"]
albedo_color = Color(0.78, 0.72, 0.45, 1)
metallic = 0.80
roughness = 0.32

; Disjuntores modulares discretos
[sub_resource type="StandardMaterial3D" id="Material_BreakerCase"]
albedo_color = Color(0.90, 0.90, 0.92, 1)
roughness = 0.38

[sub_resource type="StandardMaterial3D" id="Material_BreakerSwitch"]
albedo_color = Color(0.16, 0.17, 0.19, 1)
roughness = 0.45

; Fiações coloridas internas visíveis
[sub_resource type="StandardMaterial3D" id="Material_WireRed"]
albedo_color = Color(0.85, 0.18, 0.14, 1)
roughness = 0.45

[sub_resource type="StandardMaterial3D" id="Material_WireBlue"]
albedo_color = Color(0.15, 0.42, 0.85, 1)
roughness = 0.45

[sub_resource type="StandardMaterial3D" id="Material_WireEarth"]
albedo_color = Color(0.82, 0.78, 0.12, 1)
roughness = 0.45

; Eletrodutos e conexões metálicas
[sub_resource type="StandardMaterial3D" id="Material_ConduitTube"]
albedo_color = Color(0.70, 0.73, 0.76, 1)
metallic = 0.75
roughness = 0.35

; Pequena placa identificadora ENERGIA
[sub_resource type="StandardMaterial3D" id="Material_BadgePlate"]
albedo_color = Color(0.92, 0.92, 0.94, 1)
roughness = 0.40

; Chave seccionadora e alavanca física hero
[sub_resource type="StandardMaterial3D" id="Material_HubCast"]
albedo_color = Color(0.24, 0.26, 0.28, 1)
metallic = 0.50
roughness = 0.50

[sub_resource type="StandardMaterial3D" id="Material_LeverMetal"]
albedo_color = Color(0.90, 0.92, 0.94, 1)
metallic = 0.92
roughness = 0.18

[sub_resource type="StandardMaterial3D" id="Material_GripRed"]
albedo_color = Color(0.85, 0.14, 0.12, 1)
roughness = 0.40

; Indicadores luminosos (LEDs)
[sub_resource type="StandardMaterial3D" id="Material_LEDGreen"]
albedo_color = Color(0.15, 0.92, 0.25, 1)
emission_enabled = true
emission = Color(0.15, 0.92, 0.25, 1)
emission_energy_multiplier = 1.6

[sub_resource type="StandardMaterial3D" id="Material_LEDRed"]
albedo_color = Color(0.95, 0.15, 0.12, 1)
emission_enabled = true
emission = Color(0.95, 0.15, 0.12, 1)
emission_energy_multiplier = 1.6

; ================================================================
; MESHES DA ESTRUTURA
; ================================================================

[sub_resource type="BoxMesh" id="BoxMesh_Cabinet"]
material = SubResource("Material_CabinetBody")
size = Vector3(0.50, 0.66, 0.20)

[sub_resource type="BoxMesh" id="BoxMesh_Door"]
